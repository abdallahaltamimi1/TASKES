@model List<Employee>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            
            <th scope="col">Phone</th>
            <th scope="col">Position</th>
           
            <th scope="col">Salary</th>
            <th scope="col">Hire Date</th>

        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Id</td>
                    <td>@employee.FullName</td>
                    <td>@employee.Email</td>
                    <td>@employee.Phone</td>
                    <td>@employee.Position</td>
                    <td>@employee.Salary</td>
                    <td>@employee.HireDate</td>
                    <td><a href="@Url.Action("Details","Employee", new { id = employee.Id })">View Details</a></td>
                    <td><a href="@Url.Action("Edit", "Employee", new { id = employee.Id })">Edit</a></td>
                    <td><a href="@Url.Action("Delete", "Employee", new { id = employee.Id })">Delete</a></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3">No employees found.</td>
            </tr>
        }
        <tr>
            <td>
                <form action="@Url.Action("DeleteAll", "Employee")" method="post">
                    <button type="submit">Delete All</button>
                </form>
            </td>
        </tr>


    </tbody>
</table>
<h1>Number Of Employee : @ViewBag.EmployeesCount</h1>