@model Microsoft.AspNetCore.Identity.IdentityUser

<h2>Edit User Role</h2>

<form asp-action="Edit" method="post">

    <input type="hidden"
           name="userId"
           value="@Model.Id" />

    <label>User Name</label>
    <input value="@Model.UserName"
           class="form-control"
           readonly />

    <label>Role</label>

    <select name="roleName" class="form-control">
        @foreach (var role in ViewBag.Roles)
        {
            if (((IEnumerable<string>)ViewBag.CurrentRoles)
                .Contains((string)role.Name))
            {
                <option value="@role.Name" selected>
                    @role.Name
                </option>
            }
            else
            {
                <option value="@role.Name">
                    @role.Name
                </option>
            }
        }
    </select>

    <button type="submit" class="btn btn-success mt-3">
        Save
    </button>

    <a asp-action="Index" class="btn btn-secondary mt-3">
        Back
    </a>
</form>
