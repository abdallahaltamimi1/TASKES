
@model University_CafeteriaTASK6.Models.SupplyRequest

<h2>Request Details</h2>

<p><strong>Request ID:</strong> @Model.Id</p>
<p><strong>Date:</strong> @Model.RequestDate</p>
<p><strong>Status:</strong> @Model.Status</p>
<p><strong>Total Price:</strong> @Model.TotalPrice</p>

<h4>Requested Products</h4>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Subtotal</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.RequestItems)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Quantity</td>
                <td>@item.Price</td>
                <td>@(item.Price * item.Quantity)</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">
    Back
</a>
