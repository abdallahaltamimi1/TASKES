
@model List<University_CafeteriaTASK6.Models.SupplyRequest>

<h2>Supply Requests</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Create Request
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Date</th>
            <th>Total Price</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var request in Model)
        {
            <tr>
                <td>@request.Id</td>
                <td>@request.RequestDate.ToShortDateString()</td>
                <td>@request.TotalPrice</td>
                <td>@request.Status</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@request.Id"
                       class="btn btn-info">
                        Details
                    </a>

                    @if (request.Status == "Pending")
                    {
                        <a asp-action="Edit"
                           asp-route-id="@request.Id"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <form asp-action="Delete"
                              method="post"
                              style="display:inline">
                            <input type="hidden"
                                   name="id"
                                   value="@request.Id" />

                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('Delete request?')">
                                Delete
                            </button>
                        </form>

                        @if (User.IsInRole("Admin") ||
                             User.IsInRole("SuperAdmin"))
                        {
                            <form asp-action="Approve"
                                  method="post"
                                  style="display:inline">
                                <input type="hidden"
                                       name="id"
                                       value="@request.Id" />

                                <button class="btn btn-success">
                                    Approve
                                </button>
                            </form>

                            <form asp-action="Reject"
                                  method="post"
                                  style="display:inline">
                                <input type="hidden"
                                       name="id"
                                       value="@request.Id" />

                                <button class="btn btn-secondary">
                                    Reject
                                </button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
