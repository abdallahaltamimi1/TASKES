
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Orange University Cafeteria</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/University_Cafeteria.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="cafeteria-layout">

    <header>
        <nav class="navbar navbar-expand-lg cafeteria-navbar">
            <div class="container">

                <a class="navbar-brand cafeteria-brand"
                   asp-controller="Cafeteria"
                   asp-action="Index">
                    <span class="brand-icon">☕</span>
                    Orange<span class="brand-accent">Cafeteria</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Cafeteria"
                               asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Cafeteria"
                               asp-action="Products">Products</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Cafeteria"
                               asp-action="Suppliers">Suppliers</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Cafeteria"
                               asp-action="SupplyStatus">Supply Status</a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container cafeteria-content">
        @RenderBody()
    </main>

    <footer class="cafeteria-footer">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <span>© 2026 Orange University Cafeteria</span>
                <span>Fresh food. Better campus life.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
