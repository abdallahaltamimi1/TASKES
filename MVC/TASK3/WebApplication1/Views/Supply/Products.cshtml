@{

}
<h1>@ViewData["Title"]</h1>
<h2>@ViewData["ManagerName"]</h2>
<h2>Number of Products: @ViewData["NumberOfProducts"]</h2>
<ul class="list-group list-group-flush">
    @foreach (string product in ViewData["Products"] as string[])
    {
        <li class="list-group-item">@product</li>
    }
</ul>