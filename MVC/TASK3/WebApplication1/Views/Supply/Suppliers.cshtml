@{
}
<h1>@ViewBag.Title</h1>
<h2>Number of Suppliers: @ViewBag.NumberOfSuppliers</h2>
<ul class="list-group list-group-flush">
    @foreach (string supplier in ViewBag.Suppliers)
    {
        <li class="list-group-item">@supplier</li>
    }
</ul>