@model Product

<h2>Product Details</h2>

<div>
    <label>Product Name:</label>
    <p>@Model.Name</p>
</div>

<div>
    <label>Price:</label>
    <p>@Model.Price</p>
</div>

<div>
    <label>Quantity:</label>
    <p>@Model.Quantity</p>
</div>  
<div>
    <label>Category :</label>
    <p>@Model.CategoryId</p>
</div>  
<div>
    <label>Supplier:</label>
    <p>@Model.SupplierId</p>
</div>