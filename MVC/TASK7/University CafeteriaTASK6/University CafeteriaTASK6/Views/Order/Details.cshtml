@model Order

<h2>Order Details</h2>

<div>
    <label>Customer Name:</label>
    <p>@Model.CustomerName</p>
</div>

<div>
    <label>Status:</label>
    <p>@Model.Status</p>
</div>

<div>
    <label>Order Date:</label>
    <p>@Model.OrderDate</p>
</div>

<div>
    <label>Total Price:</label>
    <p>@Model.TotalPrice</p>
</div>

<div>
    <label>Employee ID:</label>
    <p>@Model.EmployeeId</p>
</div>